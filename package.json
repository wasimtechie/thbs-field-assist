{
  "name": "field-assist",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/admin",
    "packages/contracts",
    "packages/database"
  ],
  "scripts": {
    "demo": "npm --prefix apps/product-demo run dev",
    "demo:studio": "npm --prefix apps/product-demo run studio",
    "demo:render": "npm --prefix apps/product-demo run render",
    "promo:render": "npm --prefix apps/product-demo run promo:render",
    "promo:verify": "npm --prefix apps/product-demo run promo:verify",
    "dev": "npm run dev -w @field-assist/admin",
    "build": "npm run build -w @field-assist/admin",
    "typecheck": "tsc --noEmit -p apps/admin/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup.mjs",
    "db:start": "node scripts/database.mjs start",
    "db:stop": "node scripts/database.mjs stop",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/seed.ts",
    "db:reset": "node scripts/reset.mjs",
    "test:api": "tsx scripts/smoke.ts",
    "demo:closure": "tsx scripts/seed-closure-demo.ts",
    "demo:fttp": "tsx scripts/seed-fttp-demo.ts",
    "test:closure": "tsx scripts/check-closure-demo.ts",
    "test:fttp": "tsx scripts/check-fttp-demo.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.0",
    "dotenv": "17.2.3",
    "jose": "6.1.3",
    "json-canonicalize": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.0",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "effect": "3.22.2",
    "deepmerge-ts": "8.0.2"
  }
}
