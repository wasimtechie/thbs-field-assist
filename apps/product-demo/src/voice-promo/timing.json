    {
      "id": "hook",
      "label": "The engineer's moment",
      "from": 0,
      "durationInFrames": 180,
      "seconds": 6,
      "lines": [
        {
          "text": "Your engineer knows the work. Let the record catch up.",
          "voice": "bf_emma",
          "start": 0.35,
          "seconds": 3.2293,
          "file": "fae991066018b0b76bf5661adfbf183551d6706f71a300775b35bbabddebb2b8.wav"
        }
      ]
    },
    {
      "id": "reveal",
      "label": "Meet the voice assistant",
      "from": 180,
      "durationInFrames": 240,
      "seconds": 8,
      "lines": [
        {
          "text": "Field Assist. Voice-guided reporting, designed for the applications your engineers already use.",
          "voice": "bf_emma",
          "start": 0.35,
          "seconds": 5.398,
          "file": "448afe64075407b636c1c9ef6140128b7eca0ca224b4002fb555da471b5ba8f4.wav"
        }
      ]
    },
    {
      "id": "capture",
      "label": "Speak once, fill the record",
      "from": 420,
      "durationInFrames": 480,
      "seconds": 16,
      "lines": [
        {
          "text": "I installed the O N T in the living room. I used the existing duct. Optical receive was minus eighteen point two d B m. The service test passed. The job is complete.",
          "display": "I installed the ONT in the living room. I used the existing duct. Optical receive was −18.2 dBm. The service test passed. The job is complete.",
          "voice": "am_michael",
          "role": "ENGINEER",
          "start": 0.35,
          "seconds": 10.8365,
          "file": "37000c1a162f20a68995da894e3211714120000920251ca5db54e3fcc7249917.wav"
        }
      ]
    },
    {
      "id": "followup",
      "label": "Only the missing answer",
      "from": 900,
      "durationInFrames": 300,
      "seconds": 10,
      "lines": [
        {
          "text": "Is any follow-up work required?",
          "voice": "bm_george",
          "role": "ASSISTANT",
          "gapAfter": 0.6,
          "start": 0.35,
          "seconds": 2.1256,
          "file": "c8c2365d0ef7e9c9b253ab40a9071980b8ea7b78a0d87641894639a5df5bef8d.wav"
        },
        {
          "text": "No further work required.",
          "voice": "am_michael",
          "role": "ENGINEER",
          "gapAfter": 0.7,
          "start": 3.0756,
          "seconds": 1.7516,
          "file": "58adbfeb60543727f94f9d660edf84235d5467d5f6b58693ca774e359c0a6170.wav"
        },
        {
          "text": "Ready for your review.",
          "voice": "bf_emma",
          "start": 5.5272,
          "seconds": 1.3569,
          "file": "f38998b3fe6dd9b528918411f5974513a93d2ca56ad9690de0e36547615eed54.wav"
        }
      ]
    },
    {
      "id": "repair",
      "label": "Corrections stay in the conversation",
      "from": 1200,
      "durationInFrames": 300,
      "seconds": 10,
      "lines": [
        {
          "text": "The reading is eighteen point two. No, sorry. The reading is minus eighteen point one nine d B m.",
          "display": "The reading is 18.2. No, sorry. The reading is −18.19 dBm.",
          "voice": "am_michael",
          "role": "ENGINEER",
          "start": 0.35,
          "seconds": 6.543,
          "file": "25ceee0af77e8f2682548f033976f79c8c7602b2ac7a4b5319402ec3b783309f.wav"
        }
      ]
    },
    {
      "id": "speed",
      "label": "Early recognition benchmark",
      "from": 1500,
      "durationInFrames": 300,
      "seconds": 10,
      "lines": [
        {
          "text": "Early synthetic tests measured short-answer recognition at about zero point four five seconds.",
          "voice": "bf_emma",
          "start": 0.35,
          "seconds": 5.0616,
          "file": "d69888436bc9089e98f39911ccf7ce42ae67acdbc24df8a445ff7b4cfd8bab0e.wav"
        }
      ]
    },
    {
      "id": "offline",
      "label": "Capture offline",
      "from": 1800,
      "durationInFrames": 240,
      "seconds": 8,
      "lines": [
        {
          "text": "Capture offline after setup. Save on the phone. Sync confirmed records when connected.",
          "voice": "bf_emma",
          "start": 0.35,
          "seconds": 5.4254,
          "file": "7b091432b028f2990ab857793f8b327b5dc8b7e3206147235b21bed8a753438b.wav"
        }
      ]
    },
    {
      "id": "integration",
      "label": "Designed for your existing apps",
      "from": 2040,
      "durationInFrames": 240,
      "seconds": 8,
      "lines": [
        {
          "text": "Bring voice into your existing application, through agreed interfaces and your approved rules.",
          "voice": "bf_emma",
          "start": 0.35,
          "seconds": 4.8368,
          "file": "bd0c3e40c845d60f9741680c422c976fb3897ce620a1a2a0326b67eaab8099f2.wav"
        }
      ]
    },
    {
      "id": "adapt",
      "label": "Adapted to your requirements",
      "from": 2280,
      "durationInFrames": 360,
      "seconds": 12,
      "lines": [
        {
          "text": "Configure forms, terminology and voices. For deeper adaptation, fine-tuning can be scoped around approved engineer recordings and validated against your requirements.",
          "voice": "bf_emma",
          "start": 0.35,
          "seconds": 9.07,
          "file": "5b52bdf774ea36648c55b9871cff2949b161f625c3b5b2f5a3c641479a450adf.wav"
        }
      ]
    },
    {
      "id": "close",
      "label": "Start with one workflow",
      "from": 2640,
      "durationInFrames": 240,
      "seconds": 8,
      "lines": [
        {
          "text": "Speak the visit. Complete the record. Start with one workflow. Prove it with your engineers.",
          "voice": "bf_emma",
          "start": 0.35,
          "seconds": 5.5101,
          "file": "39704030ee9127b6680637fae83be2c67343a2159890785c8a3c352872b23a69.wav"
        }
      ]
    }
